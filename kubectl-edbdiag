#!/usr/bin/env bash
# ============================================================
#  EDB / Postgres Cluster Diagnostic Collector (kubectl-edbdiag)
#  Supports:
#    1) CNP   - EDB Postgres for Kubernetes
#    2) CNPG  - CloudNativePG (community)
#    3) PGD4K - EDB Postgres Distributed for Kubernetes
#  Works against plain Kubernetes (kubectl) or OpenShift (oc) - auto-detected.
# ============================================================

set -uo pipefail

# ------------------------------------------------------------
# 0. PRE-FLIGHT CHECKS + CLI DETECTION (oc vs kubectl)
# ------------------------------------------------------------
check_cmd() {
    if ! command -v "$1" &>/dev/null; then
        echo "ERROR: Required command '$1' not found. Please install it and re-run."
        exit 1
    fi
}
check_cmd tar

# Prefer `oc` only when it's installed AND the current context is actually
# pointed at a real OpenShift API server; otherwise fall back to `kubectl`.
# `oc whoami` alone is NOT a reliable check - it can report a user even
# against a plain/kind/vanilla Kubernetes cluster (it can resolve from the
# local kubeconfig without the server ever confirming it's OpenShift), which
# caused false "Detected OpenShift context" results on non-OpenShift
# clusters. Instead, check for an OpenShift-only API group (route.openshift.io,
# i.e. Routes) which only exists on genuine OpenShift - this requires a real
# round-trip to the API server's discovery endpoint.
KCMD=""
IS_OPENSHIFT=false
if command -v oc &>/dev/null && oc api-resources 2>/dev/null | grep -q 'route.openshift.io'; then
    IS_OPENSHIFT=true
fi

if [ "$IS_OPENSHIFT" = true ]; then
    KCMD="oc"
    echo "Detected OpenShift context - using 'oc' for all cluster commands."
elif command -v kubectl &>/dev/null; then
    KCMD="kubectl"
    echo "Using 'kubectl' for all cluster commands."
elif command -v oc &>/dev/null; then
    # No kubectl available and this isn't confirmed OpenShift either, but oc
    # is still usable for most read verbs against the current kubeconfig.
    KCMD="oc"
    echo "WARNING: 'kubectl' not found and OpenShift not detected - proceeding with 'oc' anyway."
else
    echo "ERROR: Neither 'oc' nor 'kubectl' found. Please install one and re-run."
    exit 1
fi

YQ_AVAILABLE=false
if command -v yq &>/dev/null; then
    YQ_AVAILABLE=true
else
    echo "WARNING: 'yq' not found - cluster YAML will be saved as-is (no field stripping)."
    echo "         Install yq (https://github.com/mikefarah/yq) for a cleaner output."
    echo ""
fi

# Portable replacement for `mapfile`/`readarray` (bash 4+ only). macOS ships
# bash 3.2 by default, which does not have mapfile - this was the root cause
# of the "mapfile: command not found" errors seen when running the plugin.
collect_lines() {
    # usage: collect_lines ARRAY_NAME <<< "$(some command)"
    local __name="$1"
    local __line
    eval "$__name=()"
    while IFS= read -r __line; do
        [[ -z "${__line// /}" ]] && continue
        eval "$__name+=(\"\$__line\")"
    done
}

lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }

# Exit cleanly from any prompt if the user types q/quit/exit instead of a
# valid choice, rather than silently falling through to a default.
check_quit() {
    case "$1" in
        q|Q|quit|Quit|QUIT|exit|Exit|EXIT)
            echo "Exiting - no diagnostics collected."
            exit 0
            ;;
    esac
}

# Save one container's current + previous logs, both to the nested
# pod-specific location AND to the flat, all-in-one-place $PODLOGS_DIR, so
# logs can be grepped across every pod without walking the whole tree.
#   save_container_log <namespace> <pod> <container> <nested_dir>
save_container_log() {
    local ns="$1" pod="$2" container="$3" nested_dir="$4"
    local flat_name="${ns}__${pod}__${container}"

    "$KCMD" logs "$pod" -n "$ns" -c "$container" \
        > "$nested_dir/${container}.log" 2>/dev/null || true
    "$KCMD" logs "$pod" -n "$ns" -c "$container" --previous \
        > "$nested_dir/${container}_previous.log" 2>/dev/null || true

    cp -f "$nested_dir/${container}.log" "$PODLOGS_DIR/${flat_name}.log" 2>/dev/null || true
    cp -f "$nested_dir/${container}_previous.log" "$PODLOGS_DIR/${flat_name}_previous.log" 2>/dev/null || true
}

# Discover and save every container + init container's logs for a pod.
#   save_all_pod_logs <namespace> <pod> <nested_dir>
save_all_pod_logs() {
    local ns="$1" pod="$2" nested_dir="$3"
    local containers
    containers=$("$KCMD" get pod "$pod" -n "$ns" \
        -o jsonpath='{range .spec.containers[*]}{.name}{" "}{end}{range .spec.initContainers[*]}{.name}{" "}{end}' \
        2>/dev/null)

    if [ -z "$containers" ]; then
        # Fall back to a single unnamed log capture if container discovery
        # itself failed for some reason, so pod-logs is never silently empty.
        "$KCMD" logs "$pod" -n "$ns" > "$nested_dir/pod.log" 2>/dev/null || true
        cp -f "$nested_dir/pod.log" "$PODLOGS_DIR/${ns}__${pod}.log" 2>/dev/null || true
        return
    fi

    for c in $containers; do
        save_container_log "$ns" "$pod" "$c" "$nested_dir"
    done
}

# ------------------------------------------------------------
# 1. OPERATOR VARIANT SELECTION (always asked first now)
# ------------------------------------------------------------
echo "Select Operator Variant:"
echo "  1) EDB PostgresÂ® AI for CloudNativePGâ„¢ Cluster (CNP)"
echo "  2) CloudNativePGâ„¢ (CNPG)"
echo "  3) EDB PostgresÂ® AI for CloudNativePGâ„¢ Global Cluster (PGD4K)"
echo "  q) Quit"
read -rp "Enter choice [1-3, or q to quit]: " VARIANT_CHOICE
check_quit "$VARIANT_CHOICE"

IS_PGD=false
case "$VARIANT_CHOICE" in
    1) OP_CMD="cnp"  ;;
    2) OP_CMD="cnpg" ;;
    3) OP_CMD="cnp"; IS_PGD=true ;;
    *) echo "Invalid choice, defaulting to CNPG."; OP_CMD="cnpg" ;;
esac

VARIANT_LABEL="CNP"
[ "$OP_CMD" = "cnpg" ] && VARIANT_LABEL="CNPG"
[ "$IS_PGD" = true ] && VARIANT_LABEL="PGD4K"
VARIANT_LOWER=$(lower "$VARIANT_LABEL")

echo ""
echo "=== Discovering ${VARIANT_LABEL} clusters in your Kubernetes context ==="
echo ""

# ------------------------------------------------------------
# 2. CLUSTER DISCOVERY & SCOPE SELECTION
# ------------------------------------------------------------
TARGETS=()   # each entry: "namespace|clustername"

collect_lines ALL_CLUSTERS_RAW <<< "$("$KCMD" get cluster -A --no-headers \
    -o custom-columns="NS:.metadata.namespace,NAME:.metadata.name" 2>/dev/null)"

if [ "$IS_PGD" = true ]; then
    # PGD4K: each BDR/PGD node is its own Cluster CR, so namespace and cluster
    # name are NOT fixed to a single value. Default to discovering every
    # Cluster CR so the whole PGD group gets collected in one pass.
    if [ ${#ALL_CLUSTERS_RAW[@]} -eq 0 ]; then
        echo "No clusters auto-detected. Falling back to manual entry."
        read -rp "Enter the Namespace of the PGD cluster/node  (or q to quit): " NAMESPACE
        check_quit "$NAMESPACE"
        read -rp "Enter the Cluster (node) Name (or q to quit): " CLUSTER_NAME
        check_quit "$CLUSTER_NAME"
        TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
    else
        echo "Detected PGD4K node clusters:"
        for i in "${!ALL_CLUSTERS_RAW[@]}"; do
            NS=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$i]}")
            NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$i]}")
            printf "  %2d) %-30s (namespace: %s)\n" "$((i+1))" "$NAME" "$NS"
        done
        echo ""
        echo "Select scope:"
        echo "  a) Collect ALL PGD4K nodes/clusters listed above (recommended - needed for group-level BDR/Raft diagnostics)"
        echo "  n) Collect only clusters within one specific namespace"
        echo "  m) Enter a single namespace + cluster manually"
        echo "  q) Quit"
        read -rp "Enter choice [a/n/m/q] (default a): " PGD_SCOPE
        check_quit "$PGD_SCOPE"

        case "$PGD_SCOPE" in
            n|N)
                read -rp "Enter the namespace to scope to: " SCOPE_NS
                check_quit "$SCOPE_NS"
                for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                    NS=$(awk '{print $1}' <<< "$entry")
                    NAME=$(awk '{print $2}' <<< "$entry")
                    [ "$NS" = "$SCOPE_NS" ] && TARGETS+=("${NS}|${NAME}")
                done
                ;;
            m|M)
                read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
                check_quit "$NAMESPACE"
                read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
                check_quit "$CLUSTER_NAME"
                TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
                ;;
            *)
                for entry in "${ALL_CLUSTERS_RAW[@]}"; do
                    NS=$(awk '{print $1}' <<< "$entry")
                    NAME=$(awk '{print $2}' <<< "$entry")
                    TARGETS+=("${NS}|${NAME}")
                done
                ;;
        esac
    fi
else
    # CNP / CNPG: ask whether to sweep every cluster in every namespace, or
    # collect just one specific cluster.
    echo "Select collection scope:"
    echo "  1) All ${VARIANT_LABEL} clusters, across all namespaces"
    echo "  2) A specific cluster (you provide namespace + cluster name)"
    echo "  q) Quit"
    read -rp "Enter choice [1, 2, or q]: " SCOPE_CHOICE
    check_quit "$SCOPE_CHOICE"

    if [ "$SCOPE_CHOICE" = "1" ]; then
        if [ ${#ALL_CLUSTERS_RAW[@]} -eq 0 ]; then
            echo "No clusters auto-detected in any namespace."
        fi
        for entry in "${ALL_CLUSTERS_RAW[@]}"; do
            NS=$(awk '{print $1}' <<< "$entry")
            NAME=$(awk '{print $2}' <<< "$entry")
            TARGETS+=("${NS}|${NAME}")
        done
    else
        if [ ${#ALL_CLUSTERS_RAW[@]} -gt 0 ]; then
            echo "Detected clusters:"
            for i in "${!ALL_CLUSTERS_RAW[@]}"; do
                NS=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$i]}")
                NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$i]}")
                printf "  %2d) %-30s (namespace: %s)\n" "$((i+1))" "$NAME" "$NS"
            done
            MANUAL_IDX=$(( ${#ALL_CLUSTERS_RAW[@]} + 1 ))
            echo "  ${MANUAL_IDX}) Enter manually"
            echo "  q) Quit"
            read -rp "Select cluster [1-${MANUAL_IDX}, or q]: " SEL
            check_quit "$SEL"
            if [[ "$SEL" =~ ^[0-9]+$ ]] && [ "$SEL" -ge 1 ] && [ "$SEL" -le "${#ALL_CLUSTERS_RAW[@]}" ]; then
                IDX=$(( SEL - 1 ))
                NAMESPACE=$(awk '{print $1}' <<< "${ALL_CLUSTERS_RAW[$IDX]}")
                CLUSTER_NAME=$(awk '{print $2}' <<< "${ALL_CLUSTERS_RAW[$IDX]}")
            else
                read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
                check_quit "$NAMESPACE"
                read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
                check_quit "$CLUSTER_NAME"
            fi
        else
            read -rp "Enter the Namespace of the Cluster (or q to quit): " NAMESPACE
            check_quit "$NAMESPACE"
            read -rp "Enter the Cluster Name (or q to quit): " CLUSTER_NAME
            check_quit "$CLUSTER_NAME"
        fi
        TARGETS+=("${NAMESPACE}|${CLUSTER_NAME}")
    fi
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
    echo "ERROR: No clusters selected for collection. Exiting."
    exit 1
fi

echo ""
echo "Targets to collect (${#TARGETS[@]}):"
for t in "${TARGETS[@]}"; do
    echo "  - namespace=${t%%|*}  cluster=${t##*|}"
done
echo ""

# ------------------------------------------------------------
# 3. DIRECTORY SETUP
# ------------------------------------------------------------

TIMESTAMP=$(date +%Y%m%d_%H%M%S)
if [ ${#TARGETS[@]} -eq 1 ]; then
    MAIN_DIR="edb_diag_${TARGETS[0]##*|}_${TIMESTAMP}"
else
    MAIN_DIR="edb_diag_${VARIANT_LOWER}_multi_${TIMESTAMP}"
fi

PODLOGS_DIR="$MAIN_DIR/pods-logs"

mkdir -p "$MAIN_DIR/operator_info/logs" "$MAIN_DIR/storage" "$MAIN_DIR/clusters" "$PODLOGS_DIR"
[ "$IS_PGD" = true ] && mkdir -p "$MAIN_DIR/pgd_group_info"

for dir in "$MAIN_DIR/operator_info/logs" "$MAIN_DIR/storage" "$MAIN_DIR/clusters" "$PODLOGS_DIR"; do
    if [ ! -d "$dir" ]; then
        echo "ERROR: Failed to create directory: $dir - check permissions and disk space."
        exit 1
    fi
done

echo "Starting comprehensive collection into: ${MAIN_DIR}"
echo "  (all pod logs are also mirrored flat into: ${PODLOGS_DIR})"
echo ""

# ------------------------------------------------------------
# 4. OPERATOR DISCOVERY & VERSIONING (cluster-wide, run once)
# ------------------------------------------------------------
find_op_pod() {
    "$KCMD" get pods -A -l "$1" --no-headers 2>/dev/null | head -n 1
}
find_op_pod_by_name() {
    "$KCMD" get pods -A --no-headers 2>/dev/null | grep -i "$1" | head -n 1
}

echo "Collecting operator-level info..."

OP_POD_INFO=""
if [ "$IS_PGD" = true ]; then
    OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=edb-postgres-distributed-for-kubernetes")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=pgd-operator")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod_by_name "pgd-operator")
else
    OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=cloud-native-postgresql")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod "app.kubernetes.io/name=cloudnativepg")
    [ -z "$OP_POD_INFO" ] && OP_POD_INFO=$(find_op_pod_by_name "cnpg-controller-manager")
fi

if [ -n "$OP_POD_INFO" ]; then
    OP_NS=$(awk '{print $1}' <<< "$OP_POD_INFO")
    OP_POD_NAME=$(awk '{print $2}' <<< "$OP_POD_INFO")
    echo "  Found operator pod: ${OP_POD_NAME} (ns: ${OP_NS})"

    "$KCMD" get pod "$OP_POD_NAME" -n "$OP_NS" \
        -o jsonpath='{.spec.containers[0].image}' \
        > "$MAIN_DIR/operator_info/operator_version.txt" 2>/dev/null || true

    "$KCMD" get deployment -n "$OP_NS" -o yaml \
        > "$MAIN_DIR/operator_info/operator_manifest.yaml" 2>/dev/null || true

    save_all_pod_logs "$OP_NS" "$OP_POD_NAME" "$MAIN_DIR/operator_info/logs"
else
    echo "  WARNING: Operator pod not found - skipping operator-level collection."
